# Copy to .env and fill in. Never commit .env.

# Your self-hosted SearXNG instance. Must have the JSON output format enabled:
#   in searxng settings.yml -> search.formats: [html, json]
SEARXNG_URL=http://localhost:8888

# OpenRouter (primary inference provider). https://openrouter.ai/keys
# This is the KEY, not the model — it looks like sk-or-v1-<64 hex chars>.
# Choose the model in config.toml under [llm].model, e.g.
#   model = "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free"
OPENROUTER_API_KEY=

# Telegram push target. Create a bot via @BotFather, then get the chat id by
# messaging the bot and reading https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Free key improves the ratings fallback chain.
# https://hardcover.app/account/api
HARDCOVER_API_KEY=

# Optional. Free key, 1000 req/day. Unauthenticated access is quota-exhausted.
# https://console.cloud.google.com -> enable Books API
GOOGLE_BOOKS_API_KEY=
